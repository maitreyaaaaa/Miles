VITE_BACKEND_URL=http://localhost:8000
# Rebuild after changing. The backend also enforces GOOGLE_MEET_ENABLED.
VITE_GOOGLE_MEET_ENABLED=false
VITE_SUPABASE_URL=https://your-project.supabase.co
# Supabase publishable/anon key; safe for browser use. Never put service-role keys here.
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
