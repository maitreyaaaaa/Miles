# ==============================================================================
# MILES VOICE AI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE VOICE STACK (Required)
# ------------------------------------------------------------------------------
# AssemblyAI API Key (Streaming STT v3, word-level intelligence, micro-hesitation detection)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Rime API Key (Ultra-low latency Coda neural streaming TTS & barge-in cut-off)
RIME_API_KEY=your_rime_api_key_here
RIME_SPEAKER=alpine
RIME_MODEL_ID=coda

# ------------------------------------------------------------------------------
# 2. LLM ADVERSARIAL ENGINES (At least one required)
# ------------------------------------------------------------------------------
# OpenAI / OpenRouter API Key (Supports OpenRouter 'sk-or-...' or OpenAI 'sk-proj-...')
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (Gemini 2.0 Flash — ultra low latency)
GEMINI_API_KEY=

# Anthropic Claude API Key (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 3. GOOGLE DRIVE & GOOGLE CALENDAR / MEET INTEGRATION
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=

# Google Cloud Console OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=

# Google Cloud Developer API Key (Required for Google Picker UI & public drive links)
GOOGLE_API_KEY=

# Authorized OAuth Redirect URI; register this callback in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:5173/google-integration-callback

# ------------------------------------------------------------------------------
# 4. MEETING BOT PROVIDER (Live Google Meet Bot Join)
# ------------------------------------------------------------------------------
# Recall.ai API Key (Cloud bot infrastructure to join live Google Meet, Zoom, Teams calls)
RECALL_AI_API_KEY=
# Recall.ai Region (e.g. ap-northeast-1 for Tokyo, us-east-1 for US)
RECALL_AI_REGION=ap-northeast-1
# Recall.ai Webhook Signing Secret (starts with whsec_ for verifying webhook signatures)
RECALL_AI_WEBHOOK_SECRET=
# Set the per-endpoint Svix secret instead for Recall workspaces created before 2025-12-15.
RECALL_AI_SVIX_WEBHOOK_SECRET=
# Public HTTPS page URL served by the Vercel frontend. The ticket is appended per meeting.
RECALL_AUDIO_BRIDGE_URL=https://your-app.vercel.app/meeting-bridge.html
# Generate a random secret of at least 32 characters. Keep it only on the backend.
RECALL_AUDIO_BRIDGE_SECRET=

# ------------------------------------------------------------------------------
# 5. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
APP_ENV=development
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 6. USER AUTHENTICATION (Supabase Auth)
# ------------------------------------------------------------------------------
# Configure Google OAuth and email one-time codes in Supabase Auth.
# The backend verifies access tokens using the project's public JWKS endpoint.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# ------------------------------------------------------------------------------
# 7. POSTGRESQL PERSISTENCE (Required in production)
# ------------------------------------------------------------------------------
# Runtime URL: use the Supabase transaction-pooler URL with the miles_runtime role.
# Set sslmode=require and keep the URL only in the backend secret manager.
DATABASE_URL=postgresql://miles_runtime.project-ref:password@pooler-host:6543/postgres?sslmode=require
DATABASE_POOL_MAX_SIZE=8
