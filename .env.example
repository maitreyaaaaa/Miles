# AssemblyAI API Key (Required for Real-time Streaming STT & Audio Intelligence)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Rime API Key (Required for Ultra-low Latency Streaming TTS)
RIME_API_KEY=your_rime_api_key_here

# LLM API Keys (Set at least one: OpenAI gpt-4o-mini / Gemini 2.0 Flash / Anthropic Claude)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Rime Voice Configuration
RIME_SPEAKER=cove
RIME_MODEL_ID=v1
