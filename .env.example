# ==============================================================================
# MILES VOICE AI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE VOICE STACK (Required)
# ------------------------------------------------------------------------------
# AssemblyAI API Key (Streaming STT v3, word-level intelligence, micro-hesitation detection)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Rime API Key (Ultra-low latency Coda neural streaming TTS & barge-in cut-off)
RIME_API_KEY=your_rime_api_key_here
RIME_SPEAKER=alpine
RIME_MODEL_ID=coda

# ------------------------------------------------------------------------------
# 2. LLM ADVERSARIAL ENGINES (At least one required)
# ------------------------------------------------------------------------------
# OpenAI / OpenRouter API Key (Supports OpenRouter 'sk-or-...' or OpenAI 'sk-proj-...')
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (Gemini 2.0 Flash — ultra low latency)
GEMINI_API_KEY=

# Anthropic Claude API Key (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 3. GOOGLE DRIVE & GOOGLE CALENDAR / MEET INTEGRATION
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=

# Google Cloud Console OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=

# Google Cloud Developer API Key (Required for Google Picker UI & public drive links)
GOOGLE_API_KEY=

# Authorized OAuth Redirect URI (matches your frontend or backend redirect)
GOOGLE_REDIRECT_URI=http://localhost:5173

# Optional: Pre-configured Google OAuth Refresh Token for server-side operations
GOOGLE_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 4. MEETING BOT PROVIDER (Live Google Meet Bot Join)
# ------------------------------------------------------------------------------
# Recall.ai API Key (Cloud bot infrastructure to join live Google Meet calls and stream audio)
RECALL_AI_API_KEY=

# ------------------------------------------------------------------------------
# 5. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
